      "image": 4,
      "canvas_id": "https://iiif.bodleian.ox.ac.uk/iiif/canvas/00e17536-07a3-4bf3-a58b-053e88b1b785.json",
      "image_url": "https://iiif.bodleian.ox.ac.uk/iiif/image/00e17536-07a3-4bf3-a58b-053e88b1b785/full/2000,/0/default.jpg",
      "label": "pp. [4]-[5]",
